# Python bytecode (created by running the tests or `python3 -m netsentry`)
__pycache__/
*.py[cod]

# Local development config: holds real ntfy tokens, webhook URLs and SMTP passwords.
# Ignored anywhere in the tree; only the shipped template stays tracked.
*.conf
!packaging/netsentry.conf

# Runtime data from local runs: device inventory (MACs, IPs, hostnames) and event logs
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.jsonl
*.log

# Code-check working notes (local audit output)
tests/FINDINGS.md
tests/LOG.md
tests/PASSES.md
tests/VERIFY.md

# Editor backups and scratch files
*~
*.swp
*.bak
*.orig

# OS files
Thumbs.db
desktop.ini
.DS_Store
